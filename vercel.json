{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE_WITH_RENDER_SERVICE.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://REPLACE_WITH_RENDER_SERVICE.onrender.com/health"
    },
    {
      "source": "/docs",
      "destination": "https://REPLACE_WITH_RENDER_SERVICE.onrender.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://REPLACE_WITH_RENDER_SERVICE.onrender.com/openapi.json"
    }
  ]
}